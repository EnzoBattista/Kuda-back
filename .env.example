# Base de datos
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=

# Servidor
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://127.0.0.1:4200

# Autenticación
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Mercado Pago
MP_ACCESS_TOKEN=

# SendGrid (envío de emails de confirmación)
# 1. Crear cuenta en https://sendgrid.com (free tier: 100 emails/día).
# 2. Settings -> API Keys -> Create API Key con permiso "Mail Send".
#    Pegá la key acá. Solo se muestra una vez al crearla.
SENDGRID_API_KEY=
# 3. Settings -> Sender Authentication -> Verify a Single Sender.
#    Verificá un email (cualquier Gmail/Hotmail sirve, no necesita dominio propio).
#    Cuando llegue el mail de SendGrid, clickeá el link de confirmación.
# 4. Pegá acá el mismo email verificado.
EMAIL_FROM=
